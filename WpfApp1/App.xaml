<Window x:Class="WpfApp1.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="タスク管理"
        Height="500"
        Width="900"
        Focusable="True">

    <!-- ファンクションキー -->
    <Window.InputBindings>
        <KeyBinding Key="F1" Command="{Binding AddTaskCommand}" />
        <KeyBinding Key="F2" Command="{Binding EditTaskCommand}" />
        <KeyBinding Key="F3" Command="{Binding CopyTaskCommand}" />
        <KeyBinding Key="F4" Command="{Binding DeleteTaskCommand}" />
        <KeyBinding Key="F5" Command="{Binding FilterCommand}" />
        <KeyBinding Key="F9" Command="{Binding ExportToCsvCommand}" />
        <KeyBinding Key="F10" Command="{Binding ExportToExcelCommand}" />
    </Window.InputBindings>

    <DockPanel Margin="10">

        <!-- ファンクションバー -->
        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Background="#EEE"
                    Margin="0,0,0,10">

            <Button Content="F1 新規" Command="{Binding AddTaskCommand}" Width="90" Margin="3"/>
            <Button Content="F2 編集" Command="{Binding EditTaskCommand}" Width="90" Margin="3"/>
            <Button Content="F3 複写" Command="{Binding CopyTaskCommand}" Width="90" Margin="3"/>
            <Button Content="F4 削除" Command="{Binding DeleteTaskCommand}" Width="90" Margin="3"/>
            <Button Content="F5 表示" Command="{Binding FilterCommand}" Width="90" Margin="3"/>
            <Button Content="F9 CSV" Command="{Binding ExportToCsvCommand}" Width="90" Margin="3"/>
            <Button Content="F10 Excel" Command="{Binding ExportToExcelCommand}" Width="90" Margin="3"/>

        </StackPanel>


        <!-- メインレイアウト -->
        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：検索条件 -->
            <StackPanel Grid.Column="0"
                        Margin="0,0,10,0">

                <TextBlock Text="表示条件"
                           FontWeight="Bold"
                           FontSize="14"
                           Margin="0,0,0,10"/>

                <TextBlock Text="基準日"/>
                <DatePicker SelectedDate="{Binding FilterDate.Value, Mode=TwoWay}"
                            Margin="0,5,0,10"/>

                <TextBlock Text="状態"/>
                <ComboBox ItemsSource="{Binding FilterOptions}"
                          SelectedItem="{Binding SelectedStatusFilter.Value, Mode=TwoWay}"
                          Margin="0,5,0,10"/>

            </StackPanel>


            <!-- 右：タスク一覧 -->
            <DataGrid Grid.Column="1"
                      ItemsSource="{Binding FilteredTasks}"
                      SelectedItem="{Binding SelectedTask.Value, Mode=OneWayToSource}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="タスク名"
                                        Binding="{Binding TaskName.Value}"
                                        Width="120"/>

                    <DataGridTextColumn Header="開始日"
                                        Binding="{Binding StartDate.Value, StringFormat=yyyy/MM/dd}" />

                    <DataGridTextColumn Header="終了日"
                                        Binding="{Binding EndDate.Value, StringFormat=yyyy/MM/dd}" />

                    <DataGridTextColumn Header="説明"
                                        Binding="{Binding Description.Value}"
                                        Width="150"/>

                    <DataGridTextColumn Header="状態"
                                        Binding="{Binding Status.Value}" />

                    <DataGridTextColumn Header="予定工数"
                                        Binding="{Binding PlannedHours.Value}" />

                    <DataGridTextColumn Header="実績工数"
                                        Binding="{Binding ActualHours.Value}" />

                    <DataGridTextColumn Header="乖離"
                                        Binding="{Binding Gap.Value}" />

                    <DataGridTextColumn Header="備考"
                                        Binding="{Binding Remarks.Value}"
                                        Width="120"/>

                </DataGrid.Columns>

            </DataGrid>

        </Grid>

    </DockPanel>
</Window>